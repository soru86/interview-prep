# Shared
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
KAFKA_BROKERS=localhost:9092
CONSUL_HOST=localhost
CONSUL_PORT=8500
SERVICE_HOST=host.docker.internal
MTLS_ENABLED=true
CORS_ORIGIN=true

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo

# Per-service (override in each service .env if needed)
# REGISTER: PORT=3001, DATABASE=register_db, SERVICE_NAME=register-service
# LOGIN: PORT=3002, DATABASE=login_db, SERVICE_NAME=login-service
# PROFILE: PORT=3003, DATABASE=profile_db, SERVICE_NAME=profile-service
# ORDER: PORT=3004, DATABASE=order_db, SERVICE_NAME=order-service
# NOTIFICATION: PORT=3005, DATABASE=notification_db, SERVICE_NAME=notification-service
# CATALOG: PORT=3006, DATABASE=catalog_db, SERVICE_NAME=catalog-service
# GATEWAY: PORT=4000, SERVICE_NAME=api-gateway
