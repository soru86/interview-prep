# ── Gmail ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=gmail
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json
# Gmail label that contains recruiter emails (create this label in Gmail)
GMAIL_RECRUITER_LABEL=Recruiters

# ── Ollama / DeepSeek R1 ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_TIMEOUT_SECONDS=300

# ── Resume & paths ────────────────────────────────────────────────────────────
RESUME_FOLDER=./data/resume
TRACKER_PATH=./data/tracker/recruiter_tracker.xlsx
STATE_DB_PATH=./data/state/agent.db

# ── Matching ─────────────────────────────────────────────────────────────────
MATCH_THRESHOLD=70

# ── Behavior ─────────────────────────────────────────────────────────────────
DRY_RUN=false
# Draft only — never auto-send (keep false)
AUTO_SEND=false

# ── WhatsApp (Meta Business Cloud API — recommended for production) ───────────
WHATSAPP_PROVIDER=meta
WHATSAPP_TO=971568896895
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v21.0
# template = production outbound alerts (requires approved template in Meta)
# text     = free-form messages (only within 24h after user messages your business number)
META_WHATSAPP_MESSAGE_MODE=template
META_WHATSAPP_TEMPLATE_NAME=recruiter_draft_alert
META_WHATSAPP_TEMPLATE_LANGUAGE=en

# ── WhatsApp (Twilio — optional alternative) ──────────────────────────────────
# WHATSAPP_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+971568896895

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
