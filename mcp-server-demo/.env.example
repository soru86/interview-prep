# PostgreSQL connection (prefer connection string when set)
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/postgres

# Or discrete fields (used when CONNECTION_STRING is unset):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DATABASE=postgres

# SSL: true | false | require
POSTGRES_SSL=false

# Pool & safety
POSTGRES_POOL_MAX=5
POSTGRES_READONLY=true
POSTGRES_ALLOWED_SCHEMAS=
POSTGRES_QUERY_TIMEOUT_MS=30000
POSTGRES_MAX_ROWS=1000

# Optional JSON config file (env vars override file values)
# POSTGRES_CONFIG_PATH=./config.example.json
