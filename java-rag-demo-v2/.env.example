# Ollama (fully local, no API keys required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=deepseek-r1:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text natively outputs 768-dim vectors (verified at app startup)
OLLAMA_EMBEDDING_DIMENSIONS=768
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.6

# Qdrant (defaults match docker-compose.yml)
QDRANT_HOST=localhost
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333

# RAG tuning
RAG_TOP_K=5
RAG_MIN_SCORE=0.60
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_AUTO_INGEST=true

# Memory
SHORT_TERM_MAX_MESSAGES=20
LONG_TERM_TOP_K=3
LONG_TERM_MIN_SCORE=0.55
