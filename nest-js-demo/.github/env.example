# GitHub Actions configuration reference for nest-js-demo CI/CD
#
# Configure these in GitHub: Settings → Secrets and variables → Actions
# Do NOT commit real secret values to git.

# ── Repository Variables (non-secret) ────────────────────────────────────────

AWS_REGION=us-east-1
EKS_CLUSTER_NAME=nest-js-demo-dev-cluster
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=nest-js-demo

# Optional overrides (defaults shown in workflow)
# KAFKA_BROKERS=kafka:29092

# ── Repository Secrets ─────────────────────────────────────────────────────────

# IAM role ARN created by Terraform output: github_actions_role_arn
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/nest-js-demo-dev-github-actions

# JWT signing secret injected into staging/production Helm releases
JWT_SECRET=replace-with-long-random-string

# ── GitHub Environments (optional but recommended) ───────────────────────────

# Environment: staging
#   - No required reviewers (auto-deploy after CI tests)
#   - Can reuse JWT_SECRET or use environment-specific secret

# Environment: production
#   - Enable "Required reviewers" for manual approval before prod deploy
#   - Use a production-grade JWT_SECRET

# ── Terraform outputs mapped to GitHub ───────────────────────────────────────

# terraform output ecr_registry        → ECR_REGISTRY variable
# terraform output ecr_repository_name → ECR_REPOSITORY variable
# terraform output eks_cluster_name    → EKS_CLUSTER_NAME variable
# terraform output github_actions_role_arn → AWS_ROLE_ARN secret
